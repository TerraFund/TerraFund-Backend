# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
#
# IMPORTANT: the credentials previously hardcoded in application.properties
# were committed to git history and must be rotated:
#   1. Rotate the Neon database password.
#   2. Revoke the Gmail app password (https://myaccount.google.com/apppasswords).
#   3. Generate a new random JWT secret (>= 64 hex chars).

# PostgreSQL connection string, e.g.:
#   jdbc:postgresql://ep-xxx-pooler.us-east-1.aws.neon.tech/TerraFundDB?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Gmail account used for outgoing mail (use an app password, not the account password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Initial admin account seeded on startup (ADMIN_PASSWORD left blank -> a random
# password is generated and printed once in the application log)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# HMAC secret for signing JWTs. Must be at least 32 bytes, ideally 64 random bytes.
JWT_SECRET=
